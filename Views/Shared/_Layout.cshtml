    <script>
        $(window).on('load', function() {
          $('.page_loader').fadeOut();
        });

        window.addEventListener('load', function() {
          // Your code here runs after the page has fully loaded
          AOS.init({
            once: true
          });
        });
        $("input, textarea").on("focus change", function () {
                 $(this).closest(".input_field").find(".text-danger").hide();
             });
         $("#ancHRefresh").click(function () {
                $('#imgHCaptcha').attr('src', '/captcha-psl?prefix=H&noisy=true' + new Date().toLocaleString());
                return false;
            });
         $("#btnSubmit").click(function (e) {
            e.preventDefault();

            if (!validateForm()) {
                return;
            }

            var formData = new FormData();
            formData.append("Name",$("#txtName").val().trim());
            formData.append("CompanyName", $("#txtCompanyName").val().trim());
            formData.append("ContactNo", $("#txtContactNumber").val().trim());
            formData.append("EmailId", $("#txtEmailID").val().trim());
            formData.append("Message", $("#txtMessage").val().trim());
            formData.append("Captcha", $("#txtCaptcha").val().trim());
            $.ajax({
                url: "submit-data",
                type: "POST",
                data: formData,
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.status == false) {
                    swal("Oops!", response.message, "error");
                }
                else {                    
                     $('#txtContactNumber').val('');
                     $('#txtCompanyName').val('');
                     $('#txtEmailID').val('');
                      $('#txtCaptcha').val('');
                     $('#txtMessage').val('');
                     $('#txtName').val('');
                     $( "#ancHRefresh" ).trigger( "click" );
                    $("#contactUsModal").modal("show");

                }
                },
                failure: function (response) {
                    alert(response.responseText);
                },
                error: function (response) {

                    $('#txtError').html("Rate limit exceeded. Try again later.");
                    swal("Oops!", response.message, "error");
                }
            });
        });
            $("#ancHRefresh").click(function () {         
           $('#imgHCaptcha').attr('src', '/captcha-psl?prefix=H&noisy=true' + new Date().toLocaleString());
           return false;
        });
         function validateForm() {
            var isValid = true;
            $(".text-danger").hide();

            const containsHTML = (str) => /[<>]/.test(str);
            const isValidEmail = (email) => /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email);
            const maxLengthCheck = (str, limit) => str.length <= limit;

            let name = $("#txtName").val().trim();
            if (name === "" || containsHTML(name) || !maxLengthCheck(name, 100)) {
                $("#spnName").text("Invalid name").show();
                isValid = false;
            }

            let companyName = $("#txtCompanyName").val().trim();
            if (companyName === "" || containsHTML(companyName) || !maxLengthCheck(companyName, 100)) {
                $("#spnCompanyName").text("Invalid company name").show();
                isValid = false;
            }

            let contactNo = $("#txtContactNumber").val().trim();
            if (contactNo === "" || containsHTML(contactNo) || !/^\d{10}$/.test(contactNo)) {
                $("#spnContactNumber").text("Invalid contact number").show();
                isValid = false;
            }

            let emailId = $("#txtEmailID").val().trim();
            if (emailId === "" || containsHTML(emailId) || !isValidEmail(emailId)) {
                $("#spnEmailID").text("Invalid email address").show();
                isValid = false;
            }           
            let message = $("#txtMessage").val().trim();
            if (message === "" || containsHTML(message) || !maxLengthCheck(message, 200)) {
                $("#spnMessage").text("Invalid Message").show();
                isValid = false;
            }
            return isValid;
        }

             $(document).ready(function () {               
                 if($("#divBlogContent").length>0)
                 {                   
                    LoadBlogs();
                 }
                 else if($("#divArticleContent").length>0)
                 {
                     LoadArticles();
                 }
                 else if($("#divStoryContent").length>0)
                 {
                     LoadStories();
                 }
                 else if($("#divResearchContent").length>0)
                 {
                     LoadResearchContents();
                 }
        });

                function LoadBlogs() {
                $.get("/Home/LoadBlogs", { count: 3 }, function (data) {
                    $("#divBlogContent").html(data);
                   ApplyCarousel();
                }); 
                }
                function LoadArticles() {
                $.get("/Home/LoadArticles", { count: 3 }, function (data) {
                    $("#divArticleContent").html(data);
                   ApplyCarousel();
                });
                }
                function LoadStories() {
                $.get("/Home/LoadStories", { count: 3 }, function (data) {
                    $("#divStoryContent").html(data);
                   ApplyCarousel();
                });
                }
                function LoadResearchContents() {
                $.get("/Home/LoadResearchPapers", { count: 3 }, function (data) {
                    $("#divResearchContent").html(data);
                   ApplyCarousel();
                });
                }
        function ApplyCarousel()
        {
           document.querySelectorAll('.three-col-slider').forEach((slider) => {
          const container = slider.querySelector('.swiper-container');
          const pagination = slider.querySelector('.swiper-pagination');
          const nextButton = slider.querySelector('.swiper-button-next');
          const prevButton = slider.querySelector('.swiper-button-prev');
          const navWrapper = nextButton.parentElement.parentElement; // adjust if needed

          const swiper = new Swiper(container, {
            slidesPerView: 3,
            spaceBetween: 24,
            slidesPerGroup: 1,
            loop: false,
            loopFillGroupWithBlank: true,
            breakpoints: {
              1024: {
                slidesPerView: 3,
                spaceBetween: 24,
              },
              768: {
                slidesPerView: 2.2,
                spaceBetween: 24,
              },
              600: {
                slidesPerView: 1.2,
                spaceBetween: 24,
              },
              300: {
                slidesPerView: 1.2,
                spaceBetween: 24,
              }
            },
            pagination: {
              el: pagination,
              clickable: true,
            },
            navigation: {
              nextEl: nextButton,
              prevEl: prevButton,
            },
            on: {
              init: () => toggleNavVisibility(),
              slideChange: () => toggleNavVisibility(),
              resize: () => toggleNavVisibility(),
            }
          });

          function toggleNavVisibility() {
            const prevDisabled = prevButton.classList.contains('swiper-button-disabled');
            const nextDisabled = nextButton.classList.contains('swiper-button-disabled');

            if (prevDisabled && nextDisabled) {
              navWrapper.classList.add('d-none');
            } else {
              navWrapper.classList.remove('d-none');
            }
          }
        });
        };
    </script>
