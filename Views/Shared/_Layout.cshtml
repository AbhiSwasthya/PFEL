    <style>
        .page_loader {
            position: fixed;
            width: 100%;
            height: 100%;
            z-index: 1000;
            background-color: #fff;
            display: flex;
            text-align: center;
            justify-content: center;
            flex-direction: column;
        }

            .page_loader svg {
                height: 280px;
                z-index: 100001;
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
            }

                .page_loader svg #rect4487 {
                    fill: #fff;
                }

            .page_loader .loader {
                height: 280px;
                width: 174px;
                overflow: hidden;
                position: relative;
                margin: 0 auto;
            }

            .page_loader .water {
                /* background: linear-gradient(180deg, rgba(0, 147, 214, 1) 0%, rgba(99, 178, 56, 1) 100%); */
                background-color: #EF4023;
                position: relative;
                top: 50%;
                height: 200%;
                width: 300%;
                z-index: 1000;
                border-radius: 38%;
                left: -50%;
                transform: rotate(360deg);
                transition: all 1s ease;
                animation: wave 5s linear infinite, movetop 10s linear forwards;
            }

       @@keyframes movetop {
            0%

        {
            top: 80%;
        }

        100% {
            top: 10px;
        }

        }

        @@keyframes wave {
            0%

        {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }

        }
    </style>

</head>

