                    <div class="row">
                        <div class="col-sm-12 col-md-11">
                            <div class="section_title mb-3">
                                <h2>Write to Us</h2>
                            </div>
                            <p class="mb-4">Have a question, feedback, or just want to say hello? Fill out the form below and we'll get back to you soon.</p>
                            <div class="row">
                                <div class="col-sm-12 col-md-12 col-lg-6">
                                    <div class="input_field">
                                        <div class="input">
                                            <label for="Name">Name</label>
                                            <input type="text" id="txtName" name="Name" maxlength="100" oninput="javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);">
                                        </div>
                                        <span class="fs-7 text-danger" id="spnName"> Name is required</span>
                                    </div>
                                </div>
                                <div class="col-sm-12 col-md-12 col-lg-6">
                                    <div class="input_field">
                                        <div class="input">
                                            <label for="CompanyName">Company Name</label>
                                            <input type="text" id="txtCompanyName" name="CompanyName" maxlength="100" oninput="javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);">
                                        </div>
                                        <span class="fs-7 text-danger" id="spnCompanyName"> Company Name is required</span>
                                    </div>
                                </div>
                                <div class="col-sm-12 col-md-12 col-lg-6">
                                    <div class="input_field">
                                        <div class="input">
                                            <label for="EmailID">Email ID</label>
                                            <input type="text" id="txtEmailID" name="EmailID" maxlength="100" oninput="javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);">
                                        </div>
                                        <span class="fs-7 text-danger" id="spnEmailID"> Email Address is required</span>
                                    </div>
                                </div>
                                <div class="col-sm-12 col-md-12 col-lg-6">
                                    <div class="input_field">
                                        <div class="input">
                                            <label for="ContactNumber">Contact Number</label>
                                            <input type="number" id="txtContactNumber" name="ContactNumber" maxlength="10" oninput="javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);">
                                        </div>
                                        <span class="fs-7 text-danger" id="spnContactNumber"> Contact Number is required.</span>
                                    </div>
                                </div>
                                <div class="col-sm-12">
                                    <div class="input_field">
                                        <div class="input">
                                            <label for="Message">Message</label>
                                            <textarea id="txtMessage" name="Message" maxlength="200" oninput="javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);"></textarea>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-12">
                                    <div class="row">
                                        <div class="col-sm-12 col-md-6">
                                            <div class="capcha-wrapp captcha_img">
                                                <img id="imgHCaptcha" alt="Captcha"
                                                     src="/captcha-psl?prefix=H&noisy=true" />
                                                <a id="ancHRefresh" class="captchatext refresh"><i class="fa fa-refresh"></i></a>
                                            </div>
                                        </div>
                                        <div class="col-sm-12 col-md-6">
                                            <div class="input_field">
                                                <div class="input">
                                                    <input id="txtCaptcha" placeholder="Enter Captcha" type="number" class="validate" maxlength="5"
                                                           oninput="javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);"
                                                           required="">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-12">
                                    <button class="btn" type="submit" id="btnSubmit"><i class="fa-solid fa-angle-right me-2"></i> Submit</button>
                                </div>

                            </div>
                        </div>

                    </div>
