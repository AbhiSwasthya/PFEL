@model List<PiramalSchoolOfLeadership.Models.PlaylistItem>
@{
    ViewBag.Title = "News Stories";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.BodyClass = "Videos";
}
<main>
    <div class="section ">
        <div class="inner-banner">
            <div class="banner-img"><img src="assets/images/latest-updates-banner.webp" alt="Banner"></div>
            <div class="container h-100 position-relative z-index1">
                <div class="breadcrumb-wrap">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/"><i class="bi bi-house-door"></i></a></li>
                        <li class="breadcrumb-item active" aria-current="page">Latest Updates</li>
                    </ol>
                </div>
                <div class="row justify-content-center align-items-center h-100">
                    <div class="col-sm-12 col-md-10 col-lg-9">
                        <div class="header-text">
                            <div class="prod-heading" data-aos="fade-right" data-aos-delay="100" data-aos-duration="500">PIRAMAL SCHOOL OF LEADERSHIP</div>
                            <div class="section_title mb-0" data-aos="fade-right" data-aos-delay="300" data-aos-duration="500">
                                <h1>Latest Updates</h1>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="section section-padding">
        <div class="container">
            <div class="row mb-5 pb-4 justify-content-center" data-aos="fade-up" data-aos-delay="100" data-aos-duration="500">
                <div class="col-md-12 col-lg-12 col-lg-11 col-xl-10">
                    <div class="horizontal-link" data-aos="fade-up" data-aos-delay="0" data-aos-duration="500">
                        <a class="nav-link" href="press-releases">Press Releases</a>
                        <a class="nav-link" href="news-stories">News Stories</a>
                        <a class="nav-link active" href="videos">Videos</a>
                    </div>
                </div>
            </div>


            <div class="row g-5" data-aos="fade-up" data-aos-delay="200" data-aos-duration="500">               
                @foreach (var element in Model)
                {
                    var videoId = @element.snippet.resourceid.videoid;
                    var title = @element.snippet.title;
                    <div class="col-sm-12 col-md-6 col-lg-4">
                        <div class="all-card">
                            <a data-fancybox="featured-videos" href="https://youtu.be/@element.snippet.resourceid.videoid">
                                <div class="image ratio ratio-16x9">
                                        <img src="https://i.ytimg.com/vi/@videoId/hqdefault.jpg" alt="">
                                    </div>
                                <div class="header">@title</div>
                                <div class="card_footer">
                                    <span class="btn"><i class="fa-solid fa-angle-right"></i> Play </span>
                                </div>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</main>